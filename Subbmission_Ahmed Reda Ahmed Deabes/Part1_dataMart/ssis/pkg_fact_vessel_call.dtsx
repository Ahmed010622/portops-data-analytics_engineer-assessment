    <DTS:Executable
      DTS:refId="Package\insert_fact_vessel_call"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{18b46c74-8db2-442e-904f-079622360d56}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="insert_fact_vessel_call"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="INSERT INTO PortOps_Mart.mart.fact_vessel_call&#xA;(&#xA;    date_key,&#xA;    customer_sk,&#xA;    terminal_sk,&#xA;    vessel_call_id,&#xA;    vessel_name,&#xA;    voyage_no,&#xA;    status,&#xA;    eta_datetime,&#xA;    ata_datetime,&#xA;    atd_datetime,&#xA;    berth_delay_hours,&#xA;    stay_hours,&#xA;    total_moves_planned,&#xA;    total_moves_actual,&#xA;    moves_variance,&#xA;    load_batch_id&#xA;)&#xA;SELECT&#xA;    CAST(CONVERT(VARCHAR(8),&#xA;        CASE&#xA;            WHEN ISNUMERIC(s.ata) = 1&#xA;            THEN DATEADD(DAY, FLOOR(CAST(s.ata AS FLOAT)) - 2, CAST('1900-01-01' AS DATE))&#xA;            ELSE CAST(s.ata AS DATE)&#xA;        END, 112) AS INT),&#xA; &#xA;    ISNULL((SELECT TOP 1 customer_sk FROM PortOps_Mart.mart.dim_customer&#xA;            WHERE customer_id = CASE WHEN ISNUMERIC(s.customer_id) = 1&#xA;                                     THEN CAST(s.customer_id AS INT) ELSE -1 END&#xA;            AND is_current = 1), -1),&#xA; &#xA;    ISNULL((SELECT TOP 1 terminal_sk FROM PortOps_Mart.mart.dim_terminal&#xA;            WHERE terminal_id = CASE WHEN ISNUMERIC(s.terminal_id) = 1&#xA;                                     THEN CAST(s.terminal_id AS INT) ELSE -1 END), -1),&#xA; &#xA;    CASE WHEN ISNUMERIC(s.vessel_call_id) = 1&#xA;         THEN CAST(s.vessel_call_id AS INT) ELSE NULL END,&#xA; &#xA;    LTRIM(RTRIM(s.vessel_name)),&#xA;    LTRIM(RTRIM(s.voyage_no)),&#xA;    LTRIM(RTRIM(s.status)),&#xA; &#xA;    CASE WHEN ISNUMERIC(s.eta) = 1&#xA;         THEN DATEADD(SECOND,&#xA;                CAST((CAST(s.eta AS FLOAT) - FLOOR(CAST(s.eta AS FLOAT))) * 86400 AS INT),&#xA;                DATEADD(DAY, FLOOR(CAST(s.eta AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;         ELSE CAST(s.eta AS DATETIME2) END,&#xA; &#xA;    CASE WHEN ISNUMERIC(s.ata) = 1&#xA;         THEN DATEADD(SECOND,&#xA;                CAST((CAST(s.ata AS FLOAT) - FLOOR(CAST(s.ata AS FLOAT))) * 86400 AS INT),&#xA;                DATEADD(DAY, FLOOR(CAST(s.ata AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;         ELSE CAST(s.ata AS DATETIME2) END,&#xA; &#xA;    CASE&#xA;        WHEN s.atd IS NULL OR LTRIM(RTRIM(s.atd)) = '' THEN NULL&#xA;        WHEN ISNUMERIC(s.atd) = 1&#xA;        THEN DATEADD(SECOND,&#xA;                CAST((CAST(s.atd AS FLOAT) - FLOOR(CAST(s.atd AS FLOAT))) * 86400 AS INT),&#xA;                DATEADD(DAY, FLOOR(CAST(s.atd AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;        ELSE CAST(s.atd AS DATETIME2)&#xA;    END,&#xA; &#xA;    CAST(DATEDIFF(MINUTE,&#xA;        CASE WHEN ISNUMERIC(s.eta) = 1&#xA;             THEN DATEADD(SECOND,&#xA;                    CAST((CAST(s.eta AS FLOAT) - FLOOR(CAST(s.eta AS FLOAT))) * 86400 AS INT),&#xA;                    DATEADD(DAY, FLOOR(CAST(s.eta AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;             ELSE CAST(s.eta AS DATETIME2) END,&#xA;        CASE WHEN ISNUMERIC(s.ata) = 1&#xA;             THEN DATEADD(SECOND,&#xA;                    CAST((CAST(s.ata AS FLOAT) - FLOOR(CAST(s.ata AS FLOAT))) * 86400 AS INT),&#xA;                    DATEADD(DAY, FLOOR(CAST(s.ata AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;             ELSE CAST(s.ata AS DATETIME2) END&#xA;    ) AS DECIMAL(10,4)) / 60.0,&#xA; &#xA;    CASE&#xA;        WHEN s.atd IS NULL OR LTRIM(RTRIM(s.atd)) = '' THEN NULL&#xA;        ELSE CAST(DATEDIFF(MINUTE,&#xA;            CASE WHEN ISNUMERIC(s.ata) = 1&#xA;                 THEN DATEADD(SECOND,&#xA;                        CAST((CAST(s.ata AS FLOAT) - FLOOR(CAST(s.ata AS FLOAT))) * 86400 AS INT),&#xA;                        DATEADD(DAY, FLOOR(CAST(s.ata AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;                 ELSE CAST(s.ata AS DATETIME2) END,&#xA;            CASE WHEN ISNUMERIC(s.atd) = 1&#xA;                 THEN DATEADD(SECOND,&#xA;                        CAST((CAST(s.atd AS FLOAT) - FLOOR(CAST(s.atd AS FLOAT))) * 86400 AS INT),&#xA;                        DATEADD(DAY, FLOOR(CAST(s.atd AS FLOAT)) - 2, CAST('1900-01-01' AS DATETIME2)))&#xA;                 ELSE CAST(s.atd AS DATETIME2) END&#xA;        ) AS DECIMAL(10,4)) / 60.0&#xA;    END,&#xA; &#xA;    CASE WHEN ISNUMERIC(s.total_moves_planned) = 1&#xA;         THEN CAST(s.total_moves_planned AS INT) ELSE NULL END,&#xA; &#xA;    CASE WHEN ISNUMERIC(s.total_moves_actual) = 1&#xA;         THEN CAST(s.total_moves_actual AS INT) ELSE NULL END,&#xA; &#xA;    CASE WHEN ISNUMERIC(s.total_moves_actual) = 1&#xA;          AND ISNUMERIC(s.total_moves_planned) = 1&#xA;         THEN CAST(s.total_moves_actual AS INT) - CAST(s.total_moves_planned AS INT)&#xA;         ELSE NULL END,&#xA; &#xA;    0&#xA; &#xA;FROM PortOps_Staging.stg.vessel_calls s&#xA;WHERE s.is_valid = 1&#xA;  AND s.ata IS NOT NULL&#xA;  AND LTRIM(RTRIM(s.ata)) &lt;&gt; ''" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
