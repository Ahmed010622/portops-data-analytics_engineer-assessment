          SQLTask:SqlStatementSource="MERGE PortOps_Mart.mart.dim_shift AS tgt&#xA;USING (&#xA;    SELECT&#xA;        CAST(shift_id   AS INT)             AS shift_id,&#xA;        LEFT(LTRIM(RTRIM(shift_code)), 1)   AS shift_code,&#xA;        LTRIM(RTRIM(shift_name))            AS shift_name,&#xA;        -- start_time / end_time arrive as 'HH:MM' strings&#xA;        TRY_CAST(start_time AS TIME(0))     AS start_time,&#xA;        TRY_CAST(end_time   AS TIME(0))     AS end_time,&#xA;        -- Night shift (C) crosses midnight: start &gt; end&#xA;        CASE&#xA;            WHEN TRY_CAST(start_time AS TIME) &gt; TRY_CAST(end_time AS TIME)&#xA;            THEN 1 ELSE 0&#xA;        END                                 AS crosses_midnight&#xA;    FROM PortOps_Staging.stg.shifts&#xA;    WHERE is_valid = 1&#xA;      AND shift_id IS NOT NULL&#xA;) AS src&#xA;ON tgt.shift_id = src.shift_id&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        tgt.shift_code       = src.shift_code,&#xA;        tgt.shift_name       = src.shift_name,&#xA;        tgt.start_time       = src.start_time,&#xA;        tgt.end_time         = src.end_time,&#xA;        tgt.crosses_midnight = src.crosses_midnight,&#xA;        tgt.row_updated_at   = SYSDATETIME()&#xA;WHEN NOT MATCHED BY TARGET AND src.shift_id &lt;&gt; -1 THEN&#xA;    INSERT (shift_id, shift_code, shift_name,&#xA;            start_time, end_time, crosses_midnight)&#xA;    VALUES (src.shift_id, src.shift_code, src.shift_name,&#xA;            src.start_time, src.end_time, src.crosses_midnight);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
