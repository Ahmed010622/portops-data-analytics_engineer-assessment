    <DTS:Executable
      DTS:refId="Package\INSERT fact container movement"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{71B97807-13A1-4A89-B31D-6B5B8D946EA5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT fact container movement"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="INSERT INTO mart.fact_gate_transaction&#xA;                         (gate_in_date_key, gate_out_date_key, customer_sk, terminal_sk, gate_transaction_id, container_id, truck_id, transaction_type, gate_in_datetime, gate_out_datetime, truck_turnaround_minutes, load_batch_id)&#xA;SELECT        CAST(CONVERT(VARCHAR(8), CAST(gate_in_time AS DATE), 112) AS INT) AS Expr1, CASE WHEN s.gate_out_time IS NULL OR&#xA;                         LTRIM(RTRIM(s.gate_out_time)) = '' THEN - 1 ELSE CAST(CONVERT(VARCHAR(8), CAST(s.gate_out_time AS DATE), 112) AS INT) END AS Expr2, ISNULL&#xA;                             ((SELECT        TOP (1) customer_sk&#xA;                                 FROM            mart.dim_customer&#xA;                                 WHERE        (customer_id = CASE WHEN ISNUMERIC(s.customer_id) = 1 THEN CAST(s.customer_id AS INT) ELSE - 1 END) AND (is_current = 1)), - 1) AS Expr3, ISNULL&#xA;                             ((SELECT        TOP (1) terminal_sk&#xA;                                 FROM            mart.dim_terminal&#xA;                                 WHERE        (terminal_id = CASE WHEN ISNUMERIC(s.terminal_id) = 1 THEN CAST(s.terminal_id AS INT) ELSE - 1 END)), - 1) AS Expr4, CASE WHEN ISNUMERIC(s.gate_transaction_id) &#xA;                         = 1 THEN CAST(s.gate_transaction_id AS INT) ELSE NULL END AS Expr5, LTRIM(RTRIM(container_id)) AS Expr6, LTRIM(RTRIM(truck_id)) AS Expr7, LTRIM(RTRIM(transaction_type)) AS Expr8, CAST(gate_in_time AS DATETIME2) &#xA;                         AS Expr9, CASE WHEN s.gate_out_time IS NULL OR&#xA;                         LTRIM(RTRIM(s.gate_out_time)) = '' THEN NULL ELSE CAST(s.gate_out_time AS DATETIME2) END AS Expr10, CASE WHEN s.gate_out_time IS NULL OR&#xA;                         LTRIM(RTRIM(s.gate_out_time)) = '' THEN NULL ELSE CAST(DATEDIFF(SECOND, CAST(s.gate_in_time AS DATETIME2), CAST(s.gate_out_time AS DATETIME2)) AS DECIMAL(10, 2)) / 60.0 END AS Expr11, 0 AS Expr12&#xA;FROM            PortOps_Staging.stg.gate_transactions AS s&#xA;WHERE        (is_valid = 1) AND (gate_in_time IS NOT NULL) AND (LTRIM(RTRIM(gate_in_time)) &lt;&gt; '')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
