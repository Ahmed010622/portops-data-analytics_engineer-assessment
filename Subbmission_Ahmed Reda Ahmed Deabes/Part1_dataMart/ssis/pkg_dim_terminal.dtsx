      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="-- ── STEP 3 : MERGE stg → mart (Type 1 upsert) ─────────────&#xA;MERGE PortOps_Mart.mart.dim_terminal  AS tgt&#xA;USING (&#xA;    SELECT&#xA;        CAST(terminal_id   AS INT)         AS terminal_id,&#xA;        LTRIM(RTRIM(terminal_code))        AS terminal_code,&#xA;        LTRIM(RTRIM(terminal_name))        AS terminal_name,&#xA;        LTRIM(RTRIM(zone))                 AS zone,&#xA;        LTRIM(RTRIM(terminal_type))        AS terminal_type&#xA;    FROM PortOps_Staging.stg.terminals&#xA;    WHERE is_valid = 1&#xA;      AND terminal_id IS NOT NULL&#xA;) AS src&#xA;ON tgt.terminal_id = src.terminal_id&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        tgt.terminal_code  = src.terminal_code,&#xA;        tgt.terminal_name  = src.terminal_name,&#xA;        tgt.zone           = src.zone,&#xA;        tgt.terminal_type  = src.terminal_type,&#xA;        tgt.row_updated_at = SYSDATETIME()&#xA;WHEN NOT MATCHED BY TARGET AND src.terminal_id &lt;&gt; -1 THEN&#xA;    INSERT (terminal_id, terminal_code, terminal_name, zone, terminal_type)&#xA;    VALUES (src.terminal_id, src.terminal_code, src.terminal_name,&#xA;            src.zone, src.terminal_type);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Row count check"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9BC0B815-40D6-4C40-8CC5-732C221A844E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Row count check"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="DECLARE @stg_count INT = (SELECT COUNT(*) FROM PortOps_Staging.stg.terminals WHERE is_valid = 1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
