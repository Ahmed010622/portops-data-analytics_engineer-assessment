    <DTS:Executable
      DTS:refId="Package\SQL MERGE stg to dim equipment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D55B5CF3-0533-407A-8CC3-5428B8790B4C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL MERGE stg to dim equipment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="MERGE PortOps_Mart.mart.dim_equipment AS tgt USING(SELECT        CAST(equipment_id AS INT) AS equipment_id, LTRIM(RTRIM(equipment_code)) AS equipment_code, LTRIM(RTRIM(equipment_type)) AS equipment_type, &#xA;                                                                                                                                                     CAST(terminal_id AS INT) AS terminal_id, CAST(capacity_tons AS DECIMAL(10, 2)) AS capacity_tons, &#xA;                                                                                                                                                     /* Convert Excel serial to DATE*/ CASE WHEN ISNUMERIC(acquired_date) = 1 THEN CAST(DATEADD(DAY, CAST(CAST(acquired_date AS FLOAT) AS INT) - 2, &#xA;                                                                                                                                                     CAST('1900-01-01' AS DATE)) AS DATE) WHEN TRY_CAST(acquired_date AS DATE) IS NOT NULL THEN CAST(acquired_date AS DATE) ELSE NULL END AS acquired_date, &#xA;                                                                                                                                                     LTRIM(RTRIM(ISNULL(status, 'Unknown'))) AS status&#xA;                                                                                                                            FROM            PortOps_Staging.stg.equipment&#xA;                                                                                                                            WHERE        is_valid = 1 AND equipment_id IS NOT NULL) AS src ON tgt.equipment_id = src.equipment_id WHEN MATCHED THEN&#xA;    UPDATE       &#xA;     SET                 tgt.equipment_code = src.equipment_code, tgt.equipment_type = src.equipment_type, tgt.terminal_id = src.terminal_id, tgt.capacity_tons = src.capacity_tons, tgt.acquired_date = src.acquired_date, tgt.status = src.status, &#xA;                              tgt.row_updated_at = SYSDATETIME() WHEN NOT MATCHED BY TARGET AND src.equipment_id &lt;&gt; - 1 THEN INSERT (equipment_id, equipment_code, equipment_type, terminal_id, capacity_tons, acquired_date, status)&#xA;     VALUES        (src.equipment_id, src.equipment_code, src.equipment_type, src.terminal_id, src.capacity_tons, src.acquired_date, src.status);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Row count check"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{596E9828-3CE0-47DC-9A2F-4D6C2CB1043E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Row count check"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="DECLARE @stg_eq INT = (SELECT COUNT(*) FROM PortOps_Staging.stg.equipment WHERE is_valid = 1);&#xA;   DECLARE @mrt_eq INT = (SELECT COUNT(*) FROM PortOps_Mart.mart.dim_equipment WHERE equipment_id &lt;&gt; -1);&#xA;   IF @stg_eq &lt;&gt; @mrt_eq&#xA;       RAISERROR('Equipment row count mismatch: staging=%d  mart=%d', 16, 1, @stg_eq, @mrt_eq);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
