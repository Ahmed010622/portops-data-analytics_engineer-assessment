    <DTS:Executable
      DTS:refId="Package\SQL  Truncate stg customers and stg customer history"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8130E03D-04CB-46F9-A9B3-20017C248F71}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL  Truncate stg customers and stg customer history"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{43AE403F-D165-4AC9-AED0-1DCACC08B22D}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.customers;&#xA;  &#xA;TRUNCATE TABLE stg.customer_history;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Apply Type 1 overwrites"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9BB74528-2449-47B9-95D4-61EB40BBAE36}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Apply Type 1 overwrites"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="UPDATE d&#xA;SET&#xA;    d.customer_code    = s.customer_code,&#xA;    d.customer_name    = s.customer_name,&#xA;    d.country          = s.country,&#xA;    d.active_flag      = s.active_flag,&#xA;    d.row_updated_at   = SYSDATETIME()&#xA;FROM PortOps_Mart.mart.dim_customer d&#xA;JOIN (&#xA;    SELECT&#xA;        CAST(customer_id AS INT)            AS customer_id,&#xA;        LTRIM(RTRIM(customer_code))         AS customer_code,&#xA;        LTRIM(RTRIM(customer_name))         AS customer_name,&#xA;        LTRIM(RTRIM(country))               AS country,&#xA;        CAST(active_flag AS BIT)            AS active_flag&#xA;    FROM PortOps_Staging.stg.customers&#xA;    WHERE is_valid = 1&#xA;) s ON d.customer_id = s.customer_id&#xA;WHERE d.customer_id &lt;&gt; -1;   -- never touch the Unknown member&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Insert dim_customer direct"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{c2fd0687-0521-4890-af20-34fdafa8344a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Insert dim_customer direct"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24343D4E-6962-4181-8603-9208F7302207}"
          SQLTask:SqlStatementSource="-- INSERT all customer history rows directly into dim_customer&#xA;INSERT INTO mart.dim_customer&#xA;(&#xA;    customer_id, customer_code, customer_name, country, active_flag,&#xA;    customer_tier, credit_limit, effective_from, effective_to,&#xA;    is_current, change_reason&#xA;)&#xA;SELECT&#xA;    CAST(h.customer_id AS INT),&#xA;    LTRIM(RTRIM(c.customer_code)),&#xA;    LTRIM(RTRIM(c.customer_name)),&#xA;    LTRIM(RTRIM(ISNULL(c.country, 'XX'))),&#xA;&#xA;    CASE&#xA;        WHEN LOWER(LTRIM(RTRIM(ISNULL(c.active_flag,'1'))))&#xA;             IN ('1','true','yes') THEN CAST(1 AS BIT)&#xA;        ELSE CAST(0 AS BIT)&#xA;    END,&#xA;&#xA;    LTRIM(RTRIM(h.customer_tier)),&#xA;    TRY_CAST(h.credit_limit AS DECIMAL(18,2)),&#xA;&#xA;    CASE&#xA;        WHEN ISNUMERIC(h.effective_from) = 1&#xA;        THEN CAST(DATEADD(DAY,&#xA;                 CAST(CAST(h.effective_from AS FLOAT) AS INT) - 2,&#xA;                 CAST('1900-01-01' AS DATE)) AS DATE)&#xA;        ELSE TRY_CAST(h.effective_from AS DATE)&#xA;    END,&#xA;&#xA;    CASE&#xA;        WHEN h.effective_to = '9999-12-31' THEN CAST('9999-12-31' AS DATE)&#xA;        WHEN ISNUMERIC(h.effective_to) = 1&#xA;        THEN CAST(DATEADD(DAY,&#xA;                 CAST(CAST(h.effective_to AS FLOAT) AS INT) - 2,&#xA;                 CAST('1900-01-01' AS DATE)) AS DATE)&#xA;        ELSE TRY_CAST(h.effective_to AS DATE)&#xA;    END,&#xA;&#xA;    CASE WHEN h.effective_to = '9999-12-31' THEN 1 ELSE 0 END,&#xA;&#xA;    LTRIM(RTRIM(ISNULL(h.change_reason, '')))&#xA;&#xA;FROM PortOps_Staging.stg.customer_history h&#xA;JOIN PortOps_Staging.stg.customers c&#xA;  ON LTRIM(RTRIM(c.customer_id)) = LTRIM(RTRIM(h.customer_id))&#xA;WHERE h.is_valid = 1&#xA;  AND c.is_valid = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Row count and sanity check"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4C71254C-0AC4-45CB-9497-C77B8D519A8D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Row count and sanity check"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{43AE403F-D165-4AC9-AED0-1DCACC08B22D}"
          SQLTask:SqlStatementSource="SELECT&#xA;    (SELECT COUNT(*) &#xA;     FROM PortOps_Staging.stg.vw_customer_scd_source) AS src_cnt,&#xA;     &#xA;    (SELECT COUNT(*) &#xA;     FROM PortOps_Mart.mart.dim_customer &#xA;     WHERE customer_id &lt;&gt; -1) AS mart_cnt;&#xA;SELECT 1 AS has_error&#xA;WHERE EXISTS (&#xA;    SELECT customer_id&#xA;    FROM PortOps_Mart.mart.dim_customer&#xA;    WHERE customer_id &lt;&gt; -1&#xA;    GROUP BY customer_id&#xA;    HAVING SUM(CAST(is_current AS INT)) &lt;&gt; 1&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Validate staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BE2172E4-D51F-42A6-BE6F-9D5F6B8E01D8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Validate staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{43AE403F-D165-4AC9-AED0-1DCACC08B22D}"
          SQLTask:SqlStatementSource="UPDATE PortOps_Staging.stg.customer_history&#xA;     SET    is_valid = 0, validation_message = 'effective_from is NULL or unparseable'&#xA;     WHERE  TRY_CAST(effective_from AS DATE) IS NULL AND ISNUMERIC(effective_from) = 0;&#xA;&#xA;     UPDATE PortOps_Staging.stg.customer_history&#xA;     SET    is_valid = 0, validation_message = 'customer_id has no match in stg.customers'&#xA;     WHERE  CAST(customer_id AS INT) NOT IN (&#xA;                SELECT CAST(customer_id AS INT) FROM PortOps_Staging.stg.customers);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
